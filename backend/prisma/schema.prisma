generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum ResumeParseStatus {
  PENDING
  PROCESSING
  COMPLETED
  NO_TEXT
  FAILED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(100)
  email            String            @unique @db.VarChar(254)
  passwordHash     String
  role             UserRole          @default(CANDIDATE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  refreshSessions  RefreshSession[]
  profile          CandidateProfile?
  resumes          Resume[]
  recruiterProfile RecruiterProfile?
  ownedCompany     Company?          @relation("CompanyOwner")
  postedJobs       Job[]             @relation("JobCreator")

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model CandidateProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  phone      String?  @db.VarChar(20)
  location   String?  @db.VarChar(150)
  headline   String?  @db.VarChar(150)
  bio        String?  @db.VarChar(1000)
  education  String?  @db.VarChar(500)
  experience String?  @db.VarChar(1000)
  skills     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Resume {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  originalName   String            @db.VarChar(255)
  storageKey     String            @unique @db.VarChar(255)
  mimeType       String            @db.VarChar(100)
  sizeBytes      Int
  parseStatus    ResumeParseStatus @default(PENDING)
  extractedText  String?           @db.Text
  pageCount      Int?
  parseError     String?           @db.VarChar(500)
  parsedAt       DateTime?
  parseStartedAt DateTime?
  parseAttemptId String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  analysis ResumeAnalysis?

  @@index([userId, createdAt])
  @@map("resumes")
}

model ResumeAnalysis {
  id             String   @id @default(uuid()) @db.Uuid
  resumeId       String   @unique @db.Uuid
  engineVersion  String   @db.VarChar(30)
  sourceTextHash String   @db.VarChar(64)
  overallScore   Int
  wordCount      Int
  detectedSkills String[] @default([])
  report         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_analyses")
}

model RecruiterProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  companyId String?  @db.Uuid
  jobTitle  String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("recruiter_profiles")
}

model Company {
  id                 String                    @id @default(uuid()) @db.Uuid
  ownerId            String                    @unique @db.Uuid
  name               String                    @db.VarChar(150)
  website            String?                   @db.VarChar(500)
  industry           String?                   @db.VarChar(100)
  location           String?                   @db.VarChar(150)
  description        String?                   @db.VarChar(2000)
  verificationStatus CompanyVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  owner      User               @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  recruiters RecruiterProfile[]
  jobs       Job[]

  @@map("companies")
}

model Job {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @db.Uuid
  createdById        String         @db.Uuid
  title              String         @db.VarChar(150)
  description        String         @db.VarChar(5000)
  location           String         @db.VarChar(150)
  employmentType     EmploymentType
  workMode           WorkMode
  minExperienceYears Int            @default(0)
  requiredSkills     String[]       @default([])
  preferredSkills    String[]       @default([])
  status             JobStatus      @default(DRAFT)
  publishedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User    @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([createdById, createdAt])
  @@index([status, publishedAt, id])
  @@map("jobs")
}
